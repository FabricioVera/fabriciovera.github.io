---
import "../styles/global.css";
import ClientRouter from "astro/components/ClientRouter.astro";
import { Sidebar } from "./Sidebar";
import { games } from "@data/games";

interface Props {
  gameId: string;
}

const { gameId } = Astro.props;
const game = games.find((g) => g.id === gameId);

if (!game) {
  throw new Error(`Game with id ${gameId} not found`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" , initial-scale='1.0"' />
    <link rel="icon" href="/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{game.title}</title>
    <ClientRouter />
  </head>
  <body
    class="flex flex-col bg-black font-game overflow-x-hidden"
    data-theme={gameId ? gameId : "default"}
  >
    <main class="flex-1 flex flex-col z-0">
      <background
        class="fixed inset-0 bg-cover bg-center -z-10 opacity-30"
        style={`background-image: url('${game.backgroundImage}');`}
        transition:name={`background ${game.id}`}></background>

      <header
        class="sticky top-0 z-10 bg-primary/30
         flex flex-row justify-between items-center p-4 text-center
         backdrop-blur-lg"
      >
        <Sidebar client:load transition:persist />
        <h1
          class="absolute left-0 w-full text-4xl py-2 font-extrabold text-transparent bg-clip-text bg-linear-to-r from-accent to-accent2 mb-2"
          transition:name={`gameTitle ${game.id}`}
        >
          {game.title}
        </h1>
      </header>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
  body * {
    cursor:
      url(https://i.postimg.cc/2yZBXNrC/chisato-pointer32x32.webp), auto !important;
  }
</style>
