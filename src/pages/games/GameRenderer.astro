---
// Juegos
import MbtiGame from "@components/games/guess-mbti/MbtiGame";
import AnimeGame from "@components/games/guess-anime/GameContainer";
import WarframedleGame from "@components/games/warframedle/WarframedleGame";
import WarframedleAbilitiesGame from "@components/games/warframedle/WarframedleAbility";
import ArknightDLE from "@components/games/arknights/Arknightdle";
import ArknightDLEVoiceline from "@components/games/arknights/ArknightdleVoiceline";
import ArknightDLEAbility from "@components/games/arknights/ArknightdleAbility";

interface Props {
  gameId: string;
}

const { gameId } = Astro.props;
---

{gameId === "guess-mbti" && <MbtiGame client:load />}

{gameId === "character-by-image" && <AnimeGame client:load />}

{
  gameId === "warframedle" && (
    <WarframedleGame client:only="React" gameId={gameId} />
  )
}

{
  gameId === "warframedleabilities" && (
    <WarframedleAbilitiesGame client:only="React" gameId={gameId} />
  )
}

{
  gameId === "arknightdle" && (
    <ArknightDLE client:only="React" gameId={gameId} />
  )
}
{
  gameId === "arknightdlevoicelines" && (
    <ArknightDLEVoiceline client:only="React" gameId={gameId} />
  )
}
{
  gameId === "arknightdleability" && (
    <ArknightDLEAbility client:only="React" gameId={gameId} />
  )
}

{/* Manejo de Errores: Fallback visual si el ID no está mapeado */}
{
  ![
    "guess-mbti",
    "character-by-image",
    "warframedle",
    "warframedleabilities",
    "arknightdle",
    "arknightdlevoicelines",
    "arknightdleability",
  ].includes(gameId) && (
    <div class="flex flex-col items-center justify-center p-10 text-center bg-primary/80 rounded-xl border border-secondary/50">
      <h2 class="text-2xl font-bold text-accent2 mb-2">
        Juego en Construcción
      </h2>
      <p class="text-gray-300">
        El juego '{gameId}' aún no tiene un componente asignado.
      </p>
    </div>
  )
}
